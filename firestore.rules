rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function noBlockBetween(firstUid, secondUid) {
      return firstUid == secondUid || (
        !exists(/databases/$(database)/documents/users/$(firstUid)/blocks/$(secondUid))
        && !exists(/databases/$(database)/documents/users/$(secondUid)/blocks/$(firstUid))
      );
    }

    function validVisibility(value) {
      return value in ['public', 'private', 'followers'];
    }

    function listDocument(listId) {
      return get(/databases/$(database)/documents/lists/$(listId));
    }

    function listMemberDocument(listId, uid) {
      return get(/databases/$(database)/documents/lists/$(listId)/members/$(uid));
    }

    function listAfter(listId) {
      return getAfter(/databases/$(database)/documents/lists/$(listId));
    }

    function isListOwner(listId) {
      return isSignedIn() && listDocument(listId).data.ownerUid == request.auth.uid;
    }

    function isListMember(listId) {
      return isSignedIn() && exists(/databases/$(database)/documents/lists/$(listId)/members/$(request.auth.uid));
    }

    function isListEditor(listId) {
      return isListOwner(listId)
        || (isListMember(listId) && listMemberDocument(listId, request.auth.uid).data.role == 'editor');
    }

    function conversationDocument(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() && request.auth.uid in conversationDocument(conversationId).data.participants;
    }

    function communityDocument(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId));
    }

    function communityMemberDocument(communityId, uid) {
      return get(/databases/$(database)/documents/communities/$(communityId)/members/$(uid));
    }

    function isCommunityOwner(communityId) {
      return isSignedIn() && communityDocument(communityId).data.ownerUid == request.auth.uid;
    }

    function isCommunityMember(communityId) {
      return isSignedIn() && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }

    function isCommunityModerator(communityId) {
      return isCommunityOwner(communityId)
        || (isCommunityMember(communityId)
          && communityMemberDocument(communityId, request.auth.uid).data.role == 'moderator');
    }

    function communityIsActive(communityId) {
      return communityDocument(communityId).data.isPublic == true
        && communityDocument(communityId).data.isArchived == false;
    }

    match /{path=**}/members/{memberUid} {
      allow list: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.query.limit != null
        && request.query.limit <= 100;
    }

    function validUserFields(data) {
      return data.keys().hasOnly([
        'uid',
        'username',
        'usernameLower',
        'bio',
        'photoURL',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string
      && data.username is string
      && data.usernameLower is string
      && data.bio is string
      && data.photoURL is string
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function usernameAfter(usernameLower) {
      return getAfter(/databases/$(database)/documents/usernames/$(usernameLower));
    }

    function userAfter(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid));
    }

    function validLibraryFields(data, uid, mediaKey) {
      return data.keys().hasOnly([
        'uid',
        'mediaId',
        'mediaType',
        'title',
        'posterPath',
        'releaseDate',
        'favorite',
        'watched',
        'watchlist',
        'favoriteAt',
        'watchedAt',
        'watchlistAt',
        'createdAt',
        'updatedAt'
      ])
      && data.uid == uid
      && data.mediaId is string
      && data.mediaType in ['movie', 'tv']
      && mediaKey == data.mediaType + '_' + data.mediaId
      && data.title is string
      && data.posterPath is string
      && data.releaseDate is string
      && data.favorite is bool
      && data.watched is bool
      && data.watchlist is bool
      && (data.favoriteAt == null || data.favoriteAt is timestamp)
      && (data.watchedAt == null || data.watchedAt is timestamp)
      && (data.watchlistAt == null || data.watchlistAt is timestamp)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function validPublicLibrarySettings(data, uid) {
      return data.keys().hasOnly(['uid', 'showFavorites', 'showWatched', 'updatedAt'])
        && data.uid == uid
        && data.showFavorites is bool
        && data.showWatched is bool
        && data.updatedAt is timestamp;
    }

    function validPublicMedia(data, uid, mediaKey) {
      return data.keys().hasOnly(['uid', 'mediaKey', 'mediaType', 'mediaId', 'title', 'posterPath', 'year', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.mediaKey == mediaKey
        && data.mediaType in ['movie', 'tv']
        && data.mediaId is string
        && mediaKey == data.mediaType + '_' + data.mediaId
        && data.title is string
        && data.posterPath is string
        && data.year is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function libraryPublicSettings(uid) {
      return get(/databases/$(database)/documents/users/$(uid)/publicSettings/library);
    }

    match /users/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && validUserFields(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && usernameAfter(request.resource.data.usernameLower).data.uid == uid;

      allow update: if isOwner(uid)
        && validUserFields(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && usernameAfter(request.resource.data.usernameLower).data.uid == uid;

      allow delete: if false;

      match /library/{mediaKey} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && validLibraryFields(request.resource.data, uid, mediaKey)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(uid)
          && validLibraryFields(request.resource.data, uid, mediaKey)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isOwner(uid)
          && resource.data.uid == uid
          && resource.data.uid == request.auth.uid;
      }

      match /publicSettings/{settingId} {
        allow read: if settingId == 'library';
        allow create: if settingId == 'library' && isOwner(uid)
          && validPublicLibrarySettings(request.resource.data, uid)
          && request.resource.data.updatedAt == request.time;
        allow update: if settingId == 'library' && isOwner(uid)
          && validPublicLibrarySettings(request.resource.data, uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /publicFavorites/{mediaKey} {
        allow read: if isOwner(uid)
          || (exists(/databases/$(database)/documents/users/$(uid)/publicSettings/library)
            && libraryPublicSettings(uid).data.showFavorites == true);
        allow create: if isOwner(uid) && validPublicMedia(request.resource.data, uid, mediaKey)
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid) && validPublicMedia(request.resource.data, uid, mediaKey)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.mediaKey == resource.data.mediaKey
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid) && resource.data.uid == uid;
      }

      match /publicWatched/{mediaKey} {
        allow read: if isOwner(uid)
          || (exists(/databases/$(database)/documents/users/$(uid)/publicSettings/library)
            && libraryPublicSettings(uid).data.showWatched == true);
        allow create: if isOwner(uid) && validPublicMedia(request.resource.data, uid, mediaKey)
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid) && validPublicMedia(request.resource.data, uid, mediaKey)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.mediaKey == resource.data.mediaKey
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid) && resource.data.uid == uid;
      }

      match /diary/{entryId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'uid', 'mediaKey', 'mediaId', 'mediaType', 'title', 'posterPath',
            'releaseDate', 'watchedAt', 'rating', 'rewatch', 'note', 'tags',
            'visibility', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.mediaType in ['movie', 'tv']
          && request.resource.data.mediaId is string
          && request.resource.data.mediaKey == request.resource.data.mediaType + '_' + request.resource.data.mediaId
          && request.resource.data.title is string
          && request.resource.data.posterPath is string
          && request.resource.data.releaseDate is string
          && request.resource.data.watchedAt is timestamp
          && (request.resource.data.rating == null || (request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
          && request.resource.data.rewatch is bool
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 10
          && request.resource.data.visibility == 'private'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'uid', 'mediaKey', 'mediaId', 'mediaType', 'title', 'posterPath',
            'releaseDate', 'watchedAt', 'rating', 'rewatch', 'note', 'tags',
            'visibility', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.mediaKey == resource.data.mediaKey
          && request.resource.data.mediaId == resource.data.mediaId
          && request.resource.data.mediaType == resource.data.mediaType
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.watchedAt is timestamp
          && (request.resource.data.rating == null || (request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
          && request.resource.data.rewatch is bool
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 10
          && request.resource.data.visibility == 'private'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'posterPath', 'releaseDate', 'watchedAt', 'rating', 'rewatch',
            'note', 'tags', 'visibility', 'updatedAt'
          ]);
        allow delete: if isOwner(uid) && resource.data.uid == uid;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow create: if isSignedIn()
          && request.resource.data.keys().hasAll(['type', 'actorUid', 'targetType', 'targetId', 'read', 'readAt', 'createdAt'])
          && request.resource.data.keys().hasOnly(['type', 'actorUid', 'targetType', 'targetId', 'sourceId', 'contextId', 'read', 'readAt', 'createdAt'])
          && ((request.resource.data.type in ['post_reply', 'message', 'community_post_like'] && request.resource.data.keys().hasAll(['sourceId']) && !request.resource.data.keys().hasAny(['contextId']))
            || (request.resource.data.type == 'community_post_reply' && request.resource.data.keys().hasAll(['sourceId', 'contextId']))
            || (!(request.resource.data.type in ['post_reply', 'message', 'community_post_like', 'community_post_reply']) && !request.resource.data.keys().hasAny(['sourceId', 'contextId'])))
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorUid != uid
          && request.resource.data.type in ['follow', 'post_like', 'post_reply', 'repost', 'review_like', 'list_like', 'list_member', 'message', 'community_post_like', 'community_post_reply']
          && request.resource.data.targetType in ['user', 'post', 'review', 'list', 'conversation', 'community_post']
          && request.resource.data.targetId is string
          && request.resource.data.read == false
          && request.resource.data.readAt == null
          && request.resource.data.createdAt == request.time
          && !exists(/databases/$(database)/documents/users/$(uid)/blocks/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(uid))
          && (
            (request.resource.data.type == 'follow'
              && request.resource.data.targetType == 'user'
              && request.resource.data.targetId == request.auth.uid
              && notificationId == 'follow_' + request.auth.uid
              && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid))
              && get(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)).data.followerUid == request.auth.uid
              && get(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)).data.followingUid == uid)
            || (request.resource.data.type == 'post_like'
              && request.resource.data.targetType == 'post'
              && notificationId == 'postLike_' + request.resource.data.targetId + '_' + request.auth.uid
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.targetId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.targetId)).data.ownerUid == uid
              && get(/databases/$(database)/documents/posts/$(request.resource.data.targetId)).data.visibility == 'public'
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.targetId)/likes/$(request.auth.uid)))
            || (request.resource.data.type == 'repost'
              && request.resource.data.targetType == 'post'
              && notificationId == 'repost_' + request.resource.data.targetId + '_' + request.auth.uid
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.targetId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.targetId)).data.ownerUid == uid
              && get(/databases/$(database)/documents/posts/$(request.resource.data.targetId)).data.visibility == 'public'
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.targetId)/reposts/$(request.auth.uid)))
            || (request.resource.data.type == 'post_reply'
              && request.resource.data.targetType == 'post'
              && request.resource.data.sourceId is string
              && request.resource.data.sourceId.size() > 0
              && request.resource.data.sourceId.size() <= 1500
              && notificationId == 'postReply_' + request.resource.data.targetId + '_' + request.resource.data.sourceId
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.targetId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.targetId)).data.ownerUid == uid
              && get(/databases/$(database)/documents/posts/$(request.resource.data.targetId)).data.visibility == 'public'
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.targetId)/replies/$(request.resource.data.sourceId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.targetId)/replies/$(request.resource.data.sourceId)).data.ownerUid == request.auth.uid)
            || (request.resource.data.type == 'review_like'
              && request.resource.data.targetType == 'review'
              && notificationId == 'reviewLike_' + request.resource.data.targetId + '_' + request.auth.uid
              && exists(/databases/$(database)/documents/reviews/$(request.resource.data.targetId))
              && get(/databases/$(database)/documents/reviews/$(request.resource.data.targetId)).data.uid == uid
              && exists(/databases/$(database)/documents/reviews/$(request.resource.data.targetId)/likes/$(request.auth.uid)))
            || (request.resource.data.type == 'list_like'
              && request.resource.data.targetType == 'list'
              && notificationId == 'listLike_' + request.resource.data.targetId + '_' + request.auth.uid
              && exists(/databases/$(database)/documents/lists/$(request.resource.data.targetId))
              && get(/databases/$(database)/documents/lists/$(request.resource.data.targetId)).data.ownerUid == uid
              && get(/databases/$(database)/documents/lists/$(request.resource.data.targetId)).data.isPublic == true
              && exists(/databases/$(database)/documents/lists/$(request.resource.data.targetId)/likes/$(request.auth.uid)))
            || (request.resource.data.type == 'list_member'
              && request.resource.data.targetType == 'list'
              && notificationId == 'listMember_' + request.resource.data.targetId
              && exists(/databases/$(database)/documents/lists/$(request.resource.data.targetId))
              && get(/databases/$(database)/documents/lists/$(request.resource.data.targetId)).data.ownerUid == request.auth.uid
              && get(/databases/$(database)/documents/lists/$(request.resource.data.targetId)).data.ownerUid != uid
              && exists(/databases/$(database)/documents/lists/$(request.resource.data.targetId)/members/$(uid)))
            || (request.resource.data.type == 'message'
              && request.resource.data.targetType == 'conversation'
              && request.resource.data.sourceId is string
              && request.resource.data.sourceId.size() > 0
              && request.resource.data.sourceId.size() <= 1500
              && notificationId == 'message_' + request.resource.data.targetId
              && exists(/databases/$(database)/documents/conversations/$(request.resource.data.targetId))
              && get(/databases/$(database)/documents/conversations/$(request.resource.data.targetId)).data.participants is list
              && get(/databases/$(database)/documents/conversations/$(request.resource.data.targetId)).data.participants.size() == 2
              && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.targetId)).data.participants
              && uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.targetId)).data.participants
              && get(/databases/$(database)/documents/conversations/$(request.resource.data.targetId)).data.lastMessageId == request.resource.data.sourceId
              && get(/databases/$(database)/documents/conversations/$(request.resource.data.targetId)).data.lastSenderUid == request.auth.uid
              && exists(/databases/$(database)/documents/conversations/$(request.resource.data.targetId)/messages/$(request.resource.data.sourceId))
              && get(/databases/$(database)/documents/conversations/$(request.resource.data.targetId)/messages/$(request.resource.data.sourceId)).data.senderUid == request.auth.uid)
            || (request.resource.data.type == 'community_post_like'
              && request.resource.data.targetType == 'community_post'
              && notificationId == 'communityPostLike_' + request.resource.data.targetId + '_' + request.resource.data.sourceId + '_' + request.auth.uid
              && exists(/databases/$(database)/documents/communities/$(request.resource.data.targetId))
              && get(/databases/$(database)/documents/communities/$(request.resource.data.targetId)).data.isPublic == true
              && exists(/databases/$(database)/documents/communities/$(request.resource.data.targetId)/posts/$(request.resource.data.sourceId))
              && get(/databases/$(database)/documents/communities/$(request.resource.data.targetId)/posts/$(request.resource.data.sourceId)).data.ownerUid == uid
              && exists(/databases/$(database)/documents/communities/$(request.resource.data.targetId)/posts/$(request.resource.data.sourceId)/likes/$(request.auth.uid)))
            || (request.resource.data.type == 'community_post_reply'
              && request.resource.data.targetType == 'community_post'
              && notificationId == 'communityPostReply_' + request.resource.data.targetId + '_' + request.resource.data.sourceId + '_' + request.resource.data.contextId
              && exists(/databases/$(database)/documents/communities/$(request.resource.data.targetId))
              && get(/databases/$(database)/documents/communities/$(request.resource.data.targetId)).data.isPublic == true
              && exists(/databases/$(database)/documents/communities/$(request.resource.data.targetId)/posts/$(request.resource.data.sourceId))
              && get(/databases/$(database)/documents/communities/$(request.resource.data.targetId)/posts/$(request.resource.data.sourceId)).data.ownerUid == uid
              && exists(/databases/$(database)/documents/communities/$(request.resource.data.targetId)/posts/$(request.resource.data.sourceId)/replies/$(request.resource.data.contextId))
              && get(/databases/$(database)/documents/communities/$(request.resource.data.targetId)/posts/$(request.resource.data.sourceId)/replies/$(request.resource.data.contextId)).data.ownerUid == request.auth.uid)
          );
        allow update: if (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
            && request.resource.data.read is bool
            && ((request.resource.data.read == true && request.resource.data.readAt == request.time)
              || (request.resource.data.read == false && request.resource.data.readAt == null)))
          || (isSignedIn()
            && resource.data.type == 'message'
            && resource.data.actorUid == request.auth.uid
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.type == resource.data.type
            && request.resource.data.targetType == resource.data.targetType
            && request.resource.data.targetId == resource.data.targetId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sourceId', 'read', 'readAt', 'createdAt'])
            && notificationId == 'message_' + resource.data.targetId
            && request.resource.data.read == false
            && request.resource.data.readAt == null
            && request.resource.data.createdAt == request.time
            && !exists(/databases/$(database)/documents/users/$(uid)/blocks/$(request.auth.uid))
            && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(uid))
            && exists(/databases/$(database)/documents/conversations/$(resource.data.targetId))
            && get(/databases/$(database)/documents/conversations/$(resource.data.targetId)).data.participants is list
            && get(/databases/$(database)/documents/conversations/$(resource.data.targetId)).data.participants.size() == 2
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.targetId)).data.participants
            && uid in get(/databases/$(database)/documents/conversations/$(resource.data.targetId)).data.participants
            && request.resource.data.sourceId == get(/databases/$(database)/documents/conversations/$(resource.data.targetId)).data.lastMessageId
            && get(/databases/$(database)/documents/conversations/$(resource.data.targetId)).data.lastSenderUid == request.auth.uid
            && exists(/databases/$(database)/documents/conversations/$(resource.data.targetId)/messages/$(request.resource.data.sourceId))
            && get(/databases/$(database)/documents/conversations/$(resource.data.targetId)/messages/$(request.resource.data.sourceId)).data.senderUid == request.auth.uid);
        allow delete: if isOwner(uid)
          || (isSignedIn() && resource.data.actorUid == request.auth.uid);
      }

      match /blocks/{targetUid} {
        allow get: if isOwner(uid) || (isSignedIn() && request.auth.uid == targetUid);
        allow list: if isOwner(uid) || (isSignedIn() && request.auth.uid == resource.data.targetUid);
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && targetUid != uid
          && request.resource.data.keys().hasOnly(['targetUid', 'createdAt'])
          && request.resource.data.targetUid == targetUid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }

      match /mutes/{targetUid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && targetUid != uid
          && request.resource.data.keys().hasOnly(['targetUid', 'createdAt'])
          && request.resource.data.targetUid == targetUid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }

      match /private/{documentId} {
        allow read: if documentId == 'settings' && isOwner(uid);
        allow create, update: if documentId == 'settings'
          && isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'accountPrivacy', 'spoilerFilter', 'notificationPreferences',
            'messagePermission', 'theme', 'updatedAt'
          ])
          && request.resource.data.accountPrivacy in ['public', 'private']
          && request.resource.data.spoilerFilter is bool
          && request.resource.data.notificationPreferences is map
          && request.resource.data.messagePermission in ['everyone', 'following', 'nobody']
          && request.resource.data.theme in ['dark', 'system']
          && request.resource.data.updatedAt == request.time;
        allow delete: if documentId == 'settings' && isOwner(uid);
      }
    }

    match /usernames/{usernameLower} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && userAfter(request.auth.uid).data.uid == request.auth.uid
        && userAfter(request.auth.uid).data.usernameLower == usernameLower;

