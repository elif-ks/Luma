          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/communities/$(communityId)).data.memberCount == communityDocument(communityId).data.memberCount + 1;
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['uid', 'role', 'createdAt', 'updatedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.role == 'owner'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == uid;
        allow update: if isCommunityOwner(communityId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.role in ['owner', 'member', 'moderator']
          && ((request.resource.data.role == 'owner' && getAfter(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == uid)
            || (resource.data.role == 'owner' && request.resource.data.role == 'moderator' && getAfter(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid != uid)
            || (resource.data.role != 'owner' && request.resource.data.role in ['member', 'moderator']));
        allow delete: if (isCommunityOwner(communityId) && uid != communityDocument(communityId).data.ownerUid)
          || (isOwner(uid) && resource.data.role != 'owner'
            && getAfter(/databases/$(database)/documents/communities/$(communityId)).data.memberCount == communityDocument(communityId).data.memberCount - 1);
      }

      match /posts/{postId} {
        allow read: if communityDocument(communityId).data.isPublic == true || isCommunityMember(communityId);
        allow create: if isCommunityMember(communityId) && communityIsActive(communityId)
          && request.resource.data.keys().hasOnly(['communityId', 'ownerUid', 'type', 'content', 'spoiler', 'mediaKey', 'mediaType', 'mediaId', 'mediaTitle', 'posterPath', 'pollId', 'likeCount', 'replyCount', 'lastReplyId', 'isPinned', 'createdAt', 'updatedAt'])
          && request.resource.data.communityId == communityId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.type in ['discussion', 'poll']
          && ((request.resource.data.type == 'discussion' && request.resource.data.pollId == null)
            || (request.resource.data.type == 'poll'
              && request.resource.data.pollId is string
              && existsAfter(/databases/$(database)/documents/communities/$(communityId)/polls/$(request.resource.data.pollId))
              && getAfter(/databases/$(database)/documents/communities/$(communityId)/polls/$(request.resource.data.pollId)).data.postId == postId))
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 1000
          && request.resource.data.spoiler is bool
          && (request.resource.data.mediaType == null || request.resource.data.mediaType in ['movie', 'tv'])
          && request.resource.data.likeCount == 0
          && request.resource.data.replyCount == 0
          && request.resource.data.isPinned == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/communities/$(communityId)).data.postCount == communityDocument(communityId).data.postCount + 1;
        allow update: if isSignedIn()
          && resource.data.ownerUid == request.auth.uid
          && communityIsActive(communityId)
          && request.resource.data.keys().hasOnly(['communityId', 'ownerUid', 'type', 'content', 'spoiler', 'mediaKey', 'mediaType', 'mediaId', 'mediaTitle', 'posterPath', 'pollId', 'likeCount', 'replyCount', 'lastReplyId', 'isPinned', 'createdAt', 'updatedAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'spoiler', 'mediaKey', 'mediaType', 'mediaId', 'mediaTitle', 'posterPath', 'updatedAt'])
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.communityId == resource.data.communityId
          && request.resource.data.type == resource.data.type
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.likeCount == resource.data.likeCount
          && request.resource.data.replyCount == resource.data.replyCount
          && request.resource.data.get('lastReplyId', null) == resource.data.get('lastReplyId', null)
          && request.resource.data.isPinned == resource.data.isPinned
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 1000
          && request.resource.data.spoiler is bool
          && (request.resource.data.mediaType == null || request.resource.data.mediaType in ['movie', 'tv'])
          && request.resource.data.updatedAt == request.time;
        allow update: if isCommunityModerator(communityId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned', 'updatedAt'])
          && request.resource.data.isPinned is bool
          && request.resource.data.updatedAt == request.time;
        allow update: if isCommunityMember(communityId) && communityIsActive(communityId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'updatedAt'])
          && request.resource.data.likeCount >= 0
          && ((request.resource.data.likeCount == resource.data.likeCount + 1
              && !exists(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/likes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/likes/$(request.auth.uid)))
            || (request.resource.data.likeCount == resource.data.likeCount - 1
              && exists(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/likes/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/likes/$(request.auth.uid))))
          && request.resource.data.updatedAt == request.time;
        allow update: if isCommunityMember(communityId) && communityIsActive(communityId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'lastReplyId', 'updatedAt'])
          && request.resource.data.replyCount >= 0
          && request.resource.data.lastReplyId is string
          && ((request.resource.data.replyCount == resource.data.replyCount + 1
              && !exists(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/replies/$(request.resource.data.lastReplyId))
              && existsAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/replies/$(request.resource.data.lastReplyId))
              && getAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/replies/$(request.resource.data.lastReplyId)).data.ownerUid == request.auth.uid)
            || (request.resource.data.replyCount == resource.data.replyCount - 1
              && exists(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/replies/$(request.resource.data.lastReplyId))
              && !existsAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/replies/$(request.resource.data.lastReplyId))))
          && request.resource.data.updatedAt == request.time;
        allow delete: if (isSignedIn() && resource.data.ownerUid == request.auth.uid) || isCommunityModerator(communityId);

        match /likes/{uid} {
          allow read: if communityDocument(communityId).data.isPublic == true;
          allow create: if isOwner(uid) && isCommunityMember(communityId) && communityIsActive(communityId)
            && noBlockBetween(request.auth.uid, get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.ownerUid)
            && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
            && request.resource.data.uid == uid && request.resource.data.createdAt == request.time
            && getAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.likeCount == get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.likeCount + 1;
          allow delete: if isOwner(uid) && resource.data.uid == uid
            && getAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.likeCount == get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.likeCount - 1;
          allow update: if false;
        }

        match /replies/{replyId} {
          allow read: if communityDocument(communityId).data.isPublic == true;
          allow create: if isCommunityMember(communityId) && communityIsActive(communityId)
            && noBlockBetween(request.auth.uid, get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.ownerUid)
            && request.resource.data.keys().hasOnly(['ownerUid', 'content', 'spoiler', 'createdAt', 'updatedAt'])
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.content is string && request.resource.data.content.size() >= 1 && request.resource.data.content.size() <= 500
            && request.resource.data.spoiler is bool && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.replyCount == get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.replyCount + 1;
          allow delete: if ((isSignedIn() && resource.data.ownerUid == request.auth.uid) || isCommunityModerator(communityId))
            && getAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.replyCount == get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.replyCount - 1;
          allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid && communityIsActive(communityId)
            && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'spoiler', 'updatedAt'])
            && request.resource.data.updatedAt == request.time;
        }
      }

      match /polls/{pollId} {
        allow read: if communityDocument(communityId).data.isPublic == true || isCommunityMember(communityId);
        allow create: if isCommunityMember(communityId) && communityIsActive(communityId)
          && request.resource.data.keys().hasOnly(['communityId', 'postId', 'ownerUid', 'question', 'options', 'optionCounts', 'totalVotes', 'closesAt', 'createdAt', 'updatedAt'])
          && request.resource.data.communityId == communityId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.question is string
          && request.resource.data.question.size() >= 3
          && request.resource.data.question.size() <= 160
          && request.resource.data.options is list
          && request.resource.data.options.size() >= 2
          && request.resource.data.options.size() <= 4
          && request.resource.data.optionCounts is list
          && request.resource.data.optionCounts.size() == request.resource.data.options.size()
          && request.resource.data.optionCounts[0] == 0
          && request.resource.data.optionCounts[1] == 0
          && (request.resource.data.optionCounts.size() < 3 || request.resource.data.optionCounts[2] == 0)
          && (request.resource.data.optionCounts.size() < 4 || request.resource.data.optionCounts[3] == 0)
          && request.resource.data.totalVotes == 0
          && (request.resource.data.closesAt == null || request.resource.data.closesAt is timestamp)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(request.resource.data.postId)).data.pollId == pollId;
        allow update: if isCommunityMember(communityId) && communityIsActive(communityId)
          && request.resource.data.keys().hasOnly(['communityId', 'postId', 'ownerUid', 'question', 'options', 'optionCounts', 'totalVotes', 'closesAt', 'createdAt', 'updatedAt'])
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.communityId == resource.data.communityId
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.question == resource.data.question
          && request.resource.data.options == resource.data.options
          && request.resource.data.closesAt == resource.data.closesAt
          && request.resource.data.totalVotes == resource.data.totalVotes + 1
          && request.resource.data.optionCounts is list
          && request.resource.data.optionCounts.size() == resource.data.optionCounts.size()
          && !exists(/databases/$(database)/documents/communities/$(communityId)/polls/$(pollId)/votes/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/communities/$(communityId)/polls/$(pollId)/votes/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/communities/$(communityId)/polls/$(pollId)/votes/$(request.auth.uid)).data.uid == request.auth.uid
          && (
            (getAfter(/databases/$(database)/documents/communities/$(communityId)/polls/$(pollId)/votes/$(request.auth.uid)).data.optionIndex == 0
              && request.resource.data.optionCounts[0] == resource.data.optionCounts[0] + 1
              && request.resource.data.optionCounts[1] == resource.data.optionCounts[1]
              && (resource.data.optionCounts.size() < 3 || request.resource.data.optionCounts[2] == resource.data.optionCounts[2])
              && (resource.data.optionCounts.size() < 4 || request.resource.data.optionCounts[3] == resource.data.optionCounts[3]))
            || (getAfter(/databases/$(database)/documents/communities/$(communityId)/polls/$(pollId)/votes/$(request.auth.uid)).data.optionIndex == 1
              && request.resource.data.optionCounts[0] == resource.data.optionCounts[0]
              && request.resource.data.optionCounts[1] == resource.data.optionCounts[1] + 1
              && (resource.data.optionCounts.size() < 3 || request.resource.data.optionCounts[2] == resource.data.optionCounts[2])
              && (resource.data.optionCounts.size() < 4 || request.resource.data.optionCounts[3] == resource.data.optionCounts[3]))
            || (getAfter(/databases/$(database)/documents/communities/$(communityId)/polls/$(pollId)/votes/$(request.auth.uid)).data.optionIndex == 2
              && resource.data.optionCounts.size() >= 3
              && request.resource.data.optionCounts[0] == resource.data.optionCounts[0]
              && request.resource.data.optionCounts[1] == resource.data.optionCounts[1]
              && request.resource.data.optionCounts[2] == resource.data.optionCounts[2] + 1
              && (resource.data.optionCounts.size() < 4 || request.resource.data.optionCounts[3] == resource.data.optionCounts[3]))
            || (getAfter(/databases/$(database)/documents/communities/$(communityId)/polls/$(pollId)/votes/$(request.auth.uid)).data.optionIndex == 3
              && resource.data.optionCounts.size() == 4
              && request.resource.data.optionCounts[0] == resource.data.optionCounts[0]
              && request.resource.data.optionCounts[1] == resource.data.optionCounts[1]
              && request.resource.data.optionCounts[2] == resource.data.optionCounts[2]
              && request.resource.data.optionCounts[3] == resource.data.optionCounts[3] + 1)
          )
          && request.resource.data.updatedAt == request.time;
        allow delete: if (isSignedIn() && resource.data.ownerUid == request.auth.uid) || isCommunityModerator(communityId);

        match /votes/{uid} {
          allow get: if isOwner(uid);
          allow list: if false;
          allow create: if isOwner(uid)
            && isCommunityMember(communityId)
            && communityIsActive(communityId)
            && noBlockBetween(uid, get(/databases/$(database)/documents/communities/$(communityId)/polls/$(pollId)).data.ownerUid)
            && request.resource.data.keys().hasOnly(['uid', 'optionIndex', 'createdAt'])
            && request.resource.data.uid == uid
            && request.resource.data.optionIndex is int
            && request.resource.data.optionIndex >= 0
            && request.resource.data.optionIndex < get(/databases/$(database)/documents/communities/$(communityId)/polls/$(pollId)).data.options.size()
            && (get(/databases/$(database)/documents/communities/$(communityId)/polls/$(pollId)).data.closesAt == null
              || get(/databases/$(database)/documents/communities/$(communityId)/polls/$(pollId)).data.closesAt > request.time)
            && request.resource.data.createdAt == request.time
            && getAfter(/databases/$(database)/documents/communities/$(communityId)/polls/$(pollId)).data.totalVotes == get(/databases/$(database)/documents/communities/$(communityId)/polls/$(pollId)).data.totalVotes + 1;
          allow delete, update: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
